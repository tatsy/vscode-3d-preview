{
  "name": "vscode-3d-preview",
  "publisher": "tatsy",
  "displayName": "vscode-3d-preview",
  "description": "VS Code 3D Preview",
  "version": "0.2.6",
  "icon": "logo.png",
  "homepage": "https://github.com/tatsy/vscode-3d-preview",
  "repository": {
    "type": "git",
    "url": "https://github.com/tatsy/vscode-3d-preview"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "3d",
    "obj",
    "off",
    "pcd",
    "ply",
    "stl",
    "xyz",
    "mesh",
    "polygon",
    "point cloud",
    "point set",
    "viewer",
    "vscode"
  ],
  "activationEvents": [
    "onCustomEditor:3dpreview.viewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "capabilities": {
      "untrustedWorkspaces": {
        "supported": true
      }
    },
    "customEditors": [
      {
        "viewType": "3dpreview.viewer",
        "displayName": "3D Viewer Light",
        "selector": [
          {
            "filenamePattern": "*.obj"
          },
          {
            "filenamePattern": "*.stl"
          },
          {
            "filenamePattern": "*.off"
          },
          {
            "filenamePattern": "*.ply"
          },
          {
            "filenamePattern": "*.pcd"
          },
          {
            "filenamePattern": "*.xyz"
          }
        ]
      }
    ],
    "configuration": {
      "title": "VSCode 3D Preview",
      "properties": {
        "3dpreview.hideControlsOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Fold the control panel if true is specified."
        },
        "3dpreview.showPoints": {
          "type": "boolean",
          "default": false,
          "description": "Show point cloud."
        },
        "3dpreview.showWireframe": {
          "type": "boolean",
          "default": false,
          "description": "Show wireframe."
        },
        "3dpreview.showMesh": {
          "type": "boolean",
          "default": true,
          "description": "Show mesh triangles."
        },
        "3dpreview.showGridHelper": {
          "type": "boolean",
          "default": true,
          "description": "Show grid helper."
        },
        "3dpreview.showAxesHelper": {
          "type": "boolean",
          "default": true,
          "description": "Show axes helper."
        },
        "3dpreview.backgroundColor": {
          "type": "string",
          "default": "#121212",
          "description": "Default background color."
        },
        "3dpreview.pointColor": {
          "type": "string",
          "default": "#cc0000",
          "description": "Default point color."
        },
        "3dpreview.pointSize": {
          "type": "number",
          "default": 0.5,
          "description": "Default point size."
        },
        "3dpreview.pointSizeAttenuation": {
          "type": "boolean",
          "default": true,
          "description": "Shrink points with distance from the camera. Disable to keep every point visible at a fixed on-screen size."
        },
        "3dpreview.wireframeColor": {
          "type": "string",
          "default": "#0000ff",
          "description": "Default wireframe color."
        },
        "3dpreview.wireframeWidth": {
          "type": "number",
          "default": 0.5,
          "description": "Default wireframe width."
        },
        "3dpreview.flatShading": {
          "type": "boolean",
          "default": false,
          "description": "Flat shading for mesh triangles."
        },
        "3dpreview.fogDensity": {
          "type": "number",
          "default": 0,
          "description": "Fog density."
        },
        "3dpreview.lightIntensity": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Intensity of the directional light that follows the camera. Set 0 to disable it."
        },
        "3dpreview.upAxis": {
          "type": "string",
          "default": "+Y",
          "enum": [
            "+X",
            "-X",
            "+Y",
            "-Y",
            "+Z",
            "-Z"
          ],
          "description": "Axis of the file's coordinate system that points up in the viewer. Use \"+Z\" for Z-up data such as Blender exports and \"-Y\" for OpenCV/COLMAP conventions."
        },
        "3dpreview.cameraControls": {
          "type": "string",
          "default": "trackball",
          "enum": [
            "trackball",
            "orbit"
          ],
          "enumDescriptions": [
            "Free rotation in any direction (TrackballControls).",
            "Rotation keeps the camera upright and cannot pass over the poles (OrbitControls)."
          ],
          "description": "Camera control scheme used in the viewer."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.18.0",
    "glob": "^11.0.1",
    "globals": "^17.12.0",
    "mocha": "^11.0.1",
    "typescript": "^5.7.3",
    "vscode-test": "^1.6.1"
  }
}
